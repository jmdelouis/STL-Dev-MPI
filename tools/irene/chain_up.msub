#!/bin/bash
# Irene Rome (TGCC) version of tools/hpc/chain_up.slurm: synthesis at 2N of
# the gaussianised, up-sampled target prepared in PREP
# (target_gauss_up_nested.npy, gauss_table.npz; docs/USAGE.md §4.3), cut
# back to N, histogram matching.  Outputs in RUN (default
# $S/runs/<job id>).  Ranks and time are given at submission:
#
#   ccc_msub -n 512 -T 7200 -E "--export=ALL,PREP=...,RUN=...,L=4,NITER=400" tools/irene/chain_up.msub
#
# Optional: INIT (coarse-to-fine start, e.g. the up_synthesis_nested.npy of
# the chain at N / 2), EXTRA (more stl-synth options).
#MSUB -r stl-chain
#MSUB -q rome
#MSUB -A gen17889
#MSUB -m work,scratch
#MSUB -c 1
#MSUB -o stl-chain_%I.out
#MSUB -e stl-chain_%I.out

set -eu
W=${W:-/ccc/work/cont005/gen17889/delouisj/stl-mpi}
source "$W/src/tools/irene/env.sh"
T=$W/src/tools
RUN=${RUN:-$S/runs/${SLURM_JOB_ID}}
mkdir -p "$RUN"
cd "$RUN"
echo "job $SLURM_JOB_ID: $SLURM_JOB_NUM_NODES node(s), $SLURM_NTASKS tasks, prep $PREP, L ${L:-4}, niter ${NITER:-400}, init ${INIT:-noise}, run $RUN, halo exchanges ${STL_MPI_HALO:-point-to-point}, MPI $MPI_MODULE${OMPI_MCA_pml:+ pml $OMPI_MCA_pml}${UCX_TLS:+ UCX_TLS $UCX_TLS}"
ln -sf "$PREP/target_gauss_up_nested.npy" target_gauss_up_nested.npy
cp "$PREP/gauss_table.npz" .
INIT_OPT=""
[ -n "${INIT:-}" ] && INIT_OPT="--init $INIT"
time ccc_mprun "$CARGO_TARGET_DIR/release/stl-synth" --target target_gauss_up_nested.npy \
    --L "${L:-4}" --weights ergodic --niter "${NITER:-400}" $INIT_OPT ${EXTRA:-} \
    --out up 2> up.err | tee up.log
tail -3 up.err
time "$PY" "$T/resample_nested.py" down up_synthesis_nested.npy synthesis_gauss_nested.npy
time "$PY" "$T/gaussianize.py" match gauss_table.npz synthesis_gauss_nested.npy synthesis_nested.npy
rm -f up_target.fits
echo "done $(date)"
